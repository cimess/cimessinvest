# =============================================================================
# CIMESSINVEST VERCEL PRODUCTION ENVIRONMENT VARIABLES
# Copy these values into your Vercel Project Settings -> Environment Variables
# =============================================================================

# Database (PostgreSQL - e.g. Neon, Supabase, Prisma Postgres)
DATABASE_URL="postgresql://user:password@host:5432/dbname?schema=public"

# NextAuth Authentication
NEXTAUTH_SECRET="generate_a_random_32_character_secret"
AUTH_SECRET="generate_a_random_32_character_secret"
NEXTAUTH_URL="https://yourdomain.com"

# Cloudinary Media Storage (Images / Lookbook / Videos)
CLOUDINARY_CLOUD_NAME="your_cloudinary_cloud_name"
CLOUDINARY_API_KEY="your_cloudinary_api_key"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"

# Resend Transactional Email Delivery
RESEND_API_KEY="re_your_resend_api_key"
EMAIL_FROM="CimessInvest <notifications@yourdomain.com>"

# Paystack Fintech & Billing Gateway
PAYSTACK_SECRET_KEY="sk_live_your_paystack_secret_key"
PAYSTACK_PLAN_STARTER="PLN_your_starter_plan_code"
PAYSTACK_PLAN_PROFESSIONAL="PLN_your_pro_plan_code"

# Superadmin 2FA & Emergency Recovery Config
SUPERADMIN_INIT_EMAIL="admin@yourdomain.com"
SUPERADMIN_INIT_PASSWORD="strong_initial_password"
SUPERADMIN_RECOVERY_ANSWER="your_secret_recovery_answer"
SUPERADMIN_EMAILS="admin@yourdomain.com,finance@yourdomain.com"

# Automated Scheduled Tasks (Vercel Cron Secret)
CRON_SECRET="generate_a_random_cron_secret"

# Google Gemini AI Studio (for AI Storefront Copywriter)
GEMINI_API_KEY="your_gemini_api_key"

# Public Environment Variables (Used by Frontend & SEO)
NEXT_PUBLIC_SITE_URL="https://yourdomain.com"
NEXT_PUBLIC_API_URL="https://yourdomain.com"
NEXT_PUBLIC_BRAND_NAME="CimessInvest"
NEXT_PUBLIC_WHATSAPP_NUMBER="+2348000000000"
